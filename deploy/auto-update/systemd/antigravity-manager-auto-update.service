# Managed by antigravity-manager/auto-update
[Unit]
Description=Update antigravity-manager from verified hosted CI
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service
ConditionPathExists=/etc/antigravity-manager/auto-update.json

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GH_PROMPT_DISABLED=1
ExecStart=/usr/local/sbin/antigravity-manager-auto-update poll --apply
TimeoutStartSec=30min
TimeoutStopSec=180s
KillSignal=SIGINT
KillMode=mixed
Nice=10
CPUQuota=80%
MemoryMax=1G
StandardOutput=journal
StandardError=journal
LogRateLimitIntervalSec=60s
LogRateLimitBurst=30
